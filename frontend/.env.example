# ==============================================================================
# Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env.local and adjust as needed.

# Base URL of the FastAPI backend (see ../.env.example / backend/app/main.py).
# The API client (src/lib/api.ts) reads this at build/runtime — never hardcode
# localhost elsewhere in the app.
NEXT_PUBLIC_API_URL=http://localhost:8000
