# ==============================================================================
# Amazon-Scale Semantic Product Search & Recommendation Engine
# Root Environment Configuration Template
# ==============================================================================
# NOTE: All variables in this template are OPTIONAL for local development.
# The application will automatically run using robust repository defaults
# (including the 60,000 product catalog, real HNSW index, and deterministic
# grounded explainer) without any .env file.
#
# Safe to commit: YES (.env.example contains zero secrets or credentials)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS Configuration
# Allowed origins for frontend clients. Supports JSON array format or comma-separated list.
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://127.0.0.1:3000", "http://127.0.0.1:3001"]

# ML Models & Device
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
DEVICE=cpu # 'cuda' for GPU acceleration or 'cpu'

# Data & Index Paths (Repository-relative or absolute paths)
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
INDEX_DIR=./data/indexes
MODELS_CACHE_DIR=./models/weights
EXPERIMENTS_DIR=./experiments

# Specific Data Artifact Paths
PRODUCTS_CATALOG_PATH=./data/processed/products.parquet
INTERACTIONS_PATH=./data/processed/interactions.parquet
CONTENT_EMBEDDINGS_PATH=./data/embeddings/products_title_brand_category_features_description.npy
CONTENT_EMBEDDINGS_METADATA_PATH=./data/embeddings/products_title_brand_category_features_description_metadata.json

# Vector Storage & Active Index
VECTOR_STORE_BACKEND=faiss
FAISS_INDEX_TYPE=HNSW
FAISS_INDEX_PATH=./data/indexes/hnsw_m32_efc200_efs64.index

# Retrieval & Ranking Defaults
DEFAULT_RETRIEVAL_TOP_K=100
DEFAULT_RERANKING_TOP_K=20
DEFAULT_RECOMMENDATION_TOP_K=10
HYBRID_ALPHA=0.7 # Weight for dense retrieval in hybrid score calculation (0.0 to 1.0)

# Optional Remote LLM Explanation Service (Phase 10/11)
# The deterministic evidence-grounded explainer is active by default without any LLM.
# Set ENABLE_LLM_EXPLANATIONS=true only if you want to route explanations through OpenAI.
ENABLE_LLM_EXPLANATIONS=false
LLM_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here # Optional: Obtain from https://platform.openai.com/api-keys
OPENAI_BASE_URL=                         # Optional: Azure OpenAI or local proxy endpoint

# Frontend Next.js API Target
NEXT_PUBLIC_API_URL=http://localhost:8000
