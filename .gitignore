# Data, Model Weights & FAISS Indexes
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

# Processed datasets (large parquets >100MB excluded, metadata/queries/interactions preserved)
data/processed/*.parquet
!data/processed/interactions.parquet
!data/processed/evaluation_queries.json
!data/processed/dataset_profile.json
!data/processed/dataset_profile.md
!data/processed/.gitkeep

# FAISS indexes & dense embedding binary matrices (>80-100MB excluded, metadata preserved)
data/indexes/*.index
!data/indexes/hnsw_m32_efc200_efs64.meta.json
!data/indexes/.gitkeep
!data/indexes/README.md

data/embeddings/*.npy
!data/embeddings/*_metadata.json
!data/embeddings/.gitkeep

# Model weights
models/weights/*
!models/README.md
!models/.gitkeep
*.bin
*.pt
*.safetensors

# Preserve immutable offline experiment benchmark results
!experiments/results/*.json
!experiments/results/.gitkeep
*.log

